{
  "name": "nigel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web UI for nigel — theme, component library, and application",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build -w @nigel/theme && npm run build -w @nigel/ui && npm run build -w @nigel/app",
    "dev": "npm run dev -w @nigel/app",
    "preview": "npm run preview -w @nigel/ui",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
