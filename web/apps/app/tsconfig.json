{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // This is an application, not a published library, so it emits no types.
    // Declaration emit would also fail outright on SignalWatcher(LitElement):
    // a mixin's return type has no name to write into a .d.ts.
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
