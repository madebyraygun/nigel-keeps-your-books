{
  "name": "@nigel/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for the nigel web UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts"
    },
    "./nigel": {
      "types": "./dist/themes/nigel.d.ts",
      "import": "./dist/themes/nigel.js",
      "development": "./src/themes/nigel.ts"
    },
    "./css/nigel.css": "./dist/css/nigel.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "node scripts/build-css.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
