{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // The preview harness runs under vite and node: import.meta.glob and the
    // node builtins its plugin reads the filesystem with. tsconfig.build.json
    // excludes preview/, so none of this reaches the published types.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "preview"]
}
