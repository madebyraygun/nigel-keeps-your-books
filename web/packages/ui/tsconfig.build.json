{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/__tests__",
    "**/__mocks__",
    "**/*.preview.ts",
    "preview/**"
  ]
}
