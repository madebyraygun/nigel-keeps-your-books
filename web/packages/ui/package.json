{
  "name": "@nigel/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Lit component library for the nigel web UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "development": "./src/components/index.ts"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "development": "./src/icons/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "preview": "vite --config preview/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.1.0",
    "@nigel/theme": "*",
    "@types/node": "^22.10.2",
    "axe-core": "^4.10.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
